# ============================================================
# MAXIMUS Backend — Environment Configuration
# ============================================================
# Copy to backend/.env and customize values.
# The Docker stack reads this file automatically.
# ============================================================

# ── Application ──────────────────────────────────────────────
PROJECT_NAME=MAXIMUS
PROJECT_TAGLINE=MAXIMUS — The AI brain that thinks like an application security tester
PROJECT_DESCRIPTION=Full-stack autonomous penetration testing powered by LLMs
VERSION=1.0.0
API_V1_PREFIX=/api

# ── Database ─────────────────────────────────────────────────
# IMPORTANT: Change password in production!
POSTGRES_USER=pentraai
POSTGRES_PASSWORD=pentraai_change_me_in_production
POSTGRES_DB=pentraai_assessments
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── CORS Origins ─────────────────────────────────────────────
# Dev:   http://localhost:5173,http://127.0.0.1:5173
# Local: http://localhost:31337,http://127.0.0.1:31337
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Container ─────────────────────────────────────────────────
# Pentest container name — must match docker-compose.yml
DEFAULT_CONTAINER_NAME=maximus-pentest
CONTAINER_WORKSPACE_BASE=/workspace
COMMAND_TIMEOUT=300

# ── MCP HTTP ──────────────────────────────────────────────────
# Enable HTTP MCP endpoint at POST /mcp
# Required for Claude Desktop, Cursor, and HTTP MCP clients
MCP_HTTP_ENABLED=true
MCP_HTTP_NETWORK_POLICY=localhost
BACKEND_API_URL=http://localhost:8000/api

# ── Security ─────────────────────────────────────────────────
# IMPORTANT: Generate a strong secret key:
#   openssl rand -hex 32
SECRET_KEY=your-super-secret-key-min-32-chars-change-me-in-production

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=logs
LOG_FILE_ENABLED=true
LOG_CONSOLE_ENABLED=true
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5

# ── Environment ───────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
